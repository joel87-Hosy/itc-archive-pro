PORT=5000
JWT_SECRET=change_me_please
FRONTEND_ORIGIN=https://joel87-hosy.github.io

# Firebase Admin SDK - Credentials pour l'upload de fichiers côté serveur
# Obtenir depuis: https://console.firebase.google.com → Paramètres → Comptes de service → Générer clé
# Copier le JSON en une seule ligne (sans retours à la ligne)
FIREBASE_SERVICE_ACCOUNT=

# Optional external database (PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/itc_archive

# Durable storage paths (absolute or backend-relative)
DATA_DIR=./data
SQLITE_STORAGE_PATH=./data/itc_archive.sqlite
UPLOADS_DIR=./uploads
